# Copy to .env.local / Vercel project settings. Never commit real values.

# Cloud database + auth (Supabase)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard → API Keys). Amount is ₹1,999.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=

# Google Workspace SMTP (create an App Password on the sending mailbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Saurabh@webwisedigital.net
SMTP_PASS=
MAIL_FROM=Webwise Digital <Saurabh@webwisedigital.net>

# Public site origin used in payment callbacks and auth redirects
SITE_URL=https://www.webwisedigital.net

# Google OAuth (Supabase Auth → Google provider)
# In Google Cloud the Web client Authorized redirect URI must be EXACTLY:
#   https://YOUR-PROJECT.supabase.co/auth/v1/callback
# Copy it from Supabase → Authentication → Providers → Google.
# Do not put the Vercel or webwisedigital.net URL in Google's redirect URIs.
# Those belong in Supabase → Authentication → URL Configuration (Redirect URLs).
